# IntruShield Production & Local Environment Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key for Session Signing
JWT_SECRET=intrushield-secret-key-soc-2026-dev-only

# Google OAuth 2.0 / OIDC Server Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Server-side Administrator Account Email
# Accounts authenticating via Google matching this email automatically receive Administrator role.
ADMIN_EMAIL=admin@intrushield.service
